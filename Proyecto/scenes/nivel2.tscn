position = Vector2(294, 106)
rayo_scene = ExtResource("15_ciyyo")
imagen_victoria = ExtResource("15_1vpty")
texto_victoria = "Y asi fue como el pobre Transmilenio ,El K43 que lo llevaba todas las mañanas a la universidad .Termino con irreparables daños en 2 de sus tres modulos.  La decision de la alcaldia fue subastar lo que quedaba al mejor postor ,sin embargo con la llegada del nuevo metro,el antiguo y ahora obseleto transmilenio termino en el botadero Doña Juana."
nivel_key = "nivel2"
